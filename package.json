{
  "name": "kurostream",
  "private": true,
  "version": "2.0.0",
  "description": "KuroStream - Anime Streaming, Manga Reader, Watch Parties, Full UI Customizer & Windows Desktop Edition",
  "author": "KuroStream Community",
  "homepage": "https://kurostream-m1.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/hitesh231219-eng/kurostream.git"
  },
  "bugs": {
    "url": "https://github.com/hitesh231219-eng/kurostream/issues"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "setup": "node -e \"const fs=require('node:fs');if(!fs.existsSync('.env'))fs.copyFileSync('.env.example','.env');console.log('Environment ready (.env)')\"",
    "dev": "tsx server.ts",
    "start": "tsx server.ts --prod",
    "build": "vite build",
    "build:electron-server": "esbuild src/server/electronEntry.ts --bundle --platform=node --format=cjs --outfile=electron/embedded-server.cjs",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"for (const p of ['dist','dist-electron','electron/embedded-server.cjs','server.js']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "verify": "npm run lint && npm test && npm run build && npm run build:electron-server",
    "electron:start": "npm run build && npm run build:electron-server && electron electron/main.cjs",
    "build:win": "npm run build && npm run build:electron-server && electron-builder --win --x64 --config electron-builder.json",
    "build:win-portable": "npm run build && npm run build:electron-server && electron-builder --win portable --x64 --config electron-builder.json",
    "android:sync": "npm run build && node scripts/sync-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "peerjs": "^1.5.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
