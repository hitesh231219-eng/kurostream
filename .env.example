# GEMINI_API_KEY: Optional server-side API key for Gemini AI recommendations (/api/ai/recommend).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Full-stack Express + Vite + WebSocket server port (default 3000).
PORT=3000

# APP_URL: Canonical base URL where KuroStream is running locally or in production.
APP_URL="http://localhost:3000"

# VITE_PUBLIC_SITE_URL: Optional public deployment URL displayed in Desktop/Deployment dialogs.
# Leave commented out during local development so links resolve to your localhost server.
# VITE_PUBLIC_SITE_URL="https://kurostream-m1.vercel.app"

# VITE_GITHUB_REPO: Repository slug (owner/repo) for live status lookup and release links.
VITE_GITHUB_REPO="hitesh231219-eng/kurostream"
